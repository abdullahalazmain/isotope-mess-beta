# ============================================================
#  ISOTOPE MESS — Environment Variables Template
#  Copy this file to `.env.local` for local development
#  NEVER commit real .env / .env.local files (see .gitignore)
# ============================================================

# --- Firebase (optional in dev — app falls back to local mock) ---
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- Admin / App Config ---
# Default admin password (change after first login in production)
VITE_ADMIN_PASSWORD=changeme

# --- Deployment ---
# Vercel: set to 'true' to force production mode even on localhost
VITE_FORCE_PRODUCTION=false